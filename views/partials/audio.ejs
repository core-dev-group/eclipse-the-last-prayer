<section id="soundtrack" class="section">
    <div class="container text-center">
        <h2 class="section-title">Galeri <span class="text-glow">Audio</span></h2>
        <p class="section-subtitle">DENGARKAN GEMA KEGELAPAN</p>

        <div class="audio-player-container">
            <div class="audio-visualizer">
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
                <div class="bar"></div>
            </div>
            
            <div class="audio-controls">
                <button id="playBtn" class="btn btn-glow btn-circle"><i class="fa-solid fa-play"></i></button>
                <div class="audio-info">
                    <h4>The Nameless King - Main Theme</h4>
                    <span id="audioTime">00:00 / 00:00</span>
                </div>
            </div>
            
            <audio id="bgmPlayer" src="/assets/audio/theme.mp3" loop preload="metadata"></audio>
            <p id="audioError" style="display:none; color: #ff4444; font-size: 0.8rem; margin-top: 10px;">File audio tidak ditemukan. Silakan tambahkan 'theme.mp3' ke folder assets/audio/</p>
        </div>
    </div>
</section>
