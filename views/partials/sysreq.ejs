<section id="sysreq" class="section dark-section">
    <div class="container">
        <h2 class="section-title text-center">Spesifikasi Perangkat <span class="text-glow">(SysReq)</span></h2>
        <p class="section-subtitle text-center">PERKIRAAN SEMENTARA (MASIH DALAM PENGEMBANGAN)</p>

        <div class="sysreq-grid">
            <div class="sysreq-card">
                <div class="sysreq-header">
                    <i class="fa-solid fa-mobile-screen"></i>
                    <i class="fa-solid fa-desktop" style="margin-left: -5px;"></i>
                    <h3>Spesifikasi Minimum</h3>
                </div>
                <ul class="sysreq-list">
                    <li><span>OS:</span> Android 8.0 / Windows 7 / Ubuntu 18.04</li>
                    <li><span>RAM:</span> 2 GB</li>
                    <li><span>Storage:</span> 500 MB Ruang Kosong</li>
                    <li><span>Prosesor:</span> Snapdragon 400 / Intel Core i3</li>
                    <li><span>Grafis:</span> OpenGL 2.0 compatible</li>
                </ul>
                <div class="sysreq-footer">Cukup untuk menjalankan pada pengaturan rendah</div>
            </div>

            <div class="sysreq-card recommended">
                <div class="sysreq-header">
                    <i class="fa-solid fa-bolt"></i>
                    <h3>Rekomendasi</h3>
                </div>
                <ul class="sysreq-list">
                    <li><span>OS:</span> Android 11+ / Windows 10 / Ubuntu 20.04+</li>
                    <li><span>RAM:</span> 4 GB atau lebih tinggi</li>
                    <li><span>Storage:</span> 1 GB Ruang Kosong</li>
                    <li><span>Prosesor:</span> Snapdragon 600 / Intel Core i5</li>
                    <li><span>Grafis:</span> OpenGL 3.0 / DX11 compatible</li>
                </ul>
                <div class="sysreq-footer text-glow">Pengalaman maksimal dengan animasi halus 60 FPS</div>
            </div>
        </div>
    </div>
</section>
